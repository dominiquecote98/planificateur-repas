<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Planificateur de repas</title>

<style>
:root{
    --primary:#0f766e;
    --bg:#f5f7fa;
    --card:#ffffff;
    --text:#222;
    --border:#d9e1e7;
}

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:var(--bg);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    color:var(--text);
}

header{
    background:var(--primary);
    color:white;
    padding:16px;
    font-size:1.2rem;
    font-weight:700;
    text-align:center;
}

.tabs{
    display:flex;
    position:sticky;
    top:0;
    background:white;
    z-index:10;
}

.tab{
    flex:1;
    padding:14px;
    border:none;
    background:white;
    font-weight:600;
    cursor:pointer;
}

.tab.active{
    background:var(--primary);
    color:white;
}

.section{
    display:none;
    padding:12px;
}

.section.active{
    display:block;
}

.card{
    background:var(--card);
    border-radius:12px;
    padding:12px;
    margin-bottom:12px;
    box-shadow:0 1px 4px rgba(0,0,0,.08);
}

input,
textarea,
select{
    width:100%;
    padding:10px;
    margin-top:4px;
    margin-bottom:10px;
    border:1px solid var(--border);
    border-radius:8px;
}

button.action{
    background:var(--primary);
    color:white;
    border:none;
    border-radius:8px;
    padding:10px 14px;
    cursor:pointer;
}

.meal-card{
    border:1px solid var(--border);
    border-radius:10px;
    padding:10px;
    margin-top:8px;
}

.day{
    margin-bottom:15px;
}

.day h4{
    margin-bottom:8px;
}

ul{
    padding-left:20px;
}

.small{
    color:#666;
    font-size:.9rem;
}

.delete-btn{
    background:#dc2626;
    color:white;
    border:none;
    padding:6px 10px;
    border-radius:6px;
    margin-top:8px;
}

.check-item{
    margin-bottom:8px;
}
</style>
</head>

<body>

<header>
🍽️ Planificateur de repas
</header>

<div class="tabs">
    <button class="tab active" data-tab="meals">Repas</button>
    <button class="tab" data-tab="week">Semaine</button>
    <button class="tab" data-tab="grocery">Épicerie</button>
</div>

<section id="meals" class="section active">

<div class="card">
    <h3>Ajouter un repas</h3>

    <input id="mealName" placeholder="Nom du repas">

    <input id="mealCategory"
           placeholder="Catégorie (Poulet, Pâtes, BBQ...)">

    <textarea id="mealIngredients"
        rows="4"
        placeholder="Ingrédients séparés par des virgules"></textarea>

    <button class="action" onclick="addMeal()">
        Ajouter
    </button>
</div>

<div class="card">
    <h3>Banque de repas</h3>
    <div id="mealsList"></div>
</div>

</section>

<section id="week" class="section">

<div class="card">
    <h3>Planification de la semaine</h3>

    <div id="weekPlanner"></div>
</div>

</section>

<section id="grocery" class="section">

<div class="card">
    <h3>Ingrédients déjà disponibles</h3>
    <div id="inventory"></div>
</div>

<div class="card">
    <h3>Liste d'épicerie</h3>
    <div id="groceryList"></div>
</div>

</section>

<script>

const DAYS = [
"Lundi",
"Mardi",
"Mercredi",
"Jeudi",
"Vendredi",
"Samedi",
"Dimanche"
];

let meals =
JSON.parse(localStorage.getItem("mealbank")) || [];

let plan =
JSON.parse(localStorage.getItem("mealplan")) || {};

let pantry =
JSON.parse(localStorage.getItem("pantry")) || [];

function saveAll(){
    localStorage.setItem(
        "mealbank",
        JSON.stringify(meals)
    );

    localStorage.setItem(
        "mealplan",
        JSON.stringify(plan)
    );

    localStorage.setItem(
        "pantry",
        JSON.stringify(pantry)
    );
}

document.querySelectorAll(".tab").forEach(btn=>{
    btn.addEventListener("click",()=>{

        document
            .querySelectorAll(".tab")
            .forEach(t=>t.classList.remove("active"));

        document
            .querySelectorAll(".section")
            .forEach(s=>s.classList.remove("active"));

        btn.classList.add("active");

        document
            .getElementById(btn.dataset.tab)
            .classList.add("active");
    });
});

function addMeal(){

    const name =
    document.getElementById("mealName")
    .value.trim();

    const category =
    document.getElementById("mealCategory")
    .value.trim();

    const ingredients =
    document.getElementById("mealIngredients")
    .value
    .split(",")
    .map(i=>i.trim())
    .filter(Boolean);

    if(!name || ingredients.length===0)
        return;

    meals.push({
        id:Date.now(),
        name,
        category,
        ingredients
    });

    saveAll();

    document.getElementById("mealName").value="";
    document.getElementById("mealCategory").value="";
    document.getElementById("mealIngredients").value="";

    renderMeals();
    renderWeek();
}

function deleteMeal(id){

    meals =
    meals.filter(m=>m.id!==id);

    saveAll();

    renderMeals();
    renderWeek();
    renderInventory();
}

function renderMeals(){

    const div =
    document.getElementById("mealsList");

    div.innerHTML = "";

    meals.forEach(meal=>{

        div.innerHTML += `
        <div class="meal-card">
            <strong>${meal.name}</strong><br>
            <span class="small">
                ${meal.category}
            </span><br><br>

            ${meal.ingredients.join(", ")}

            <br>

            <button
                class="delete-btn"
                onclick="deleteMeal(${meal.id})">

                Supprimer
            </button>
        </div>`;
    });
}

function renderWeek(){

    const container =
    document.getElementById("weekPlanner");

    let html="";

    DAYS.forEach(day=>{

        html += `
        <div class="day">
            <h4>${day}</h4>

            <label>Dîner</label>

            <select
                onchange="
                updatePlan(
                '${day}',
                'diner',
                this.value)">

                <option value="">
                    --
                </option>

                ${buildOptions(
                    plan[day]?.diner
                )}

            </select>

            <label>Souper</label>

            <select
                onchange="
                updatePlan(
                '${day}',
                'souper',
                this.value)">

                <option value="">
                    --
                </option>

                ${buildOptions(
                    plan[day]?.souper
                )}

            </select>
        </div>`;
    });

    container.innerHTML = html;
}

function buildOptions(selected){

    return meals.map(m=>`
    <option
        value="${m.name}"
        ${selected===m.name ?
        "selected" : ""}>
        ${m.name}
    </option>`).join("");
}

function updatePlan(
    day,
    mealTime,
    value){

    if(!plan[day])
        plan[day]={};

    plan[day][mealTime] = value;

    saveAll();

    renderInventory();
}

function getIngredients(){

    const set = new Set();

    Object.values(plan).forEach(day=>{

        Object.values(day).forEach(mealName=>{

            const meal =
            meals.find(
                m=>m.name===mealName);

            if(meal){

                meal.ingredients
                .forEach(i=>set.add(i));
            }
        });
    });

    return [...set];
}

function renderInventory(){

    const container =
    document.getElementById("inventory");

    const ingredients =
    getIngredients();

    container.innerHTML="";

    ingredients.forEach(item=>{

        const checked =
        pantry.includes(item);

        container.innerHTML += `
        <div class="check-item">
            <label>

            <input
                type="checkbox"
                ${checked?"checked":""}
                onchange="
                togglePantry(
                '${item}')">

            ${item}

            </label>
        </div>`;
    });

    renderGrocery();
}

function togglePantry(item){

    if(pantry.includes(item)){

        pantry=
        pantry.filter(
            p=>p!==item);

    }else{

        pantry.push(item);
    }

    saveAll();

    renderInventory();
}

function renderGrocery(){

    const container =
    document.getElementById(
        "groceryList"
    );

    const grocery =
    getIngredients()
    .filter(
        i=>!pantry.includes(i));

    if(grocery.length===0){

        container.innerHTML =
        "✅ Rien à acheter";

        return;
    }

    container.innerHTML =
    "<ul>" +
    grocery.map(
        g=>`<li>${g}</li>`
    ).join("") +
    "</ul>";
}

renderMeals();
renderWeek();
renderInventory();

</script>

</body>
</html>
